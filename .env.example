SERVER_PORT=8080
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://127.0.0.1:3000

# Remote Supabase project identity.
SUPABASE_PROJECT_REF=

# Backend database connection.
# Use the Supabase shared pooler session-mode URL for IPv4-only local networks:
# jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=
SPRING_FLYWAY_ENABLED=true
DB_POOL_MAX_SIZE=3
DB_POOL_MIN_IDLE=0
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_MAX_LIFETIME_MS=600000

# Frontend Supabase Auth/API configuration.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_SERVER_API_URL=http://localhost:8080/api
COMPOSE_NEXT_SERVER_API_URL=http://backend:8080/api

# Backend Supabase JWT/storage configuration.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URI=
DOTAOPS_IMAGES_BUCKET=dotaops-images
DOTAOPS_AVATARS_BUCKET=avatars
DOTAOPS_TEAM_ASSETS_BUCKET=team-assets

# OpenDota integration.
OPENDOTA_API_BASE_URL=https://api.opendota.com/api
OPENDOTA_API_KEY=
OPENDOTA_CONNECT_TIMEOUT=2s
OPENDOTA_READ_TIMEOUT=5s
OPENDOTA_RETRY_MAX_ATTEMPTS=3
OPENDOTA_RETRY_BACKOFF=250ms

# Steam integration.
STEAM_CONNECT_TIMEOUT=2s
STEAM_READ_TIMEOUT=5s
STEAM_OPENID_ENDPOINT=https://steamcommunity.com/openid/login
STEAM_OPENID_REALM=http://localhost:8080
STEAM_OPENID_RETURN_URL=http://localhost:8080/api/auth/steam/callback
STEAM_WEB_API_KEY=
STEAM_PLAYER_SUMMARIES_URL=https://api.steampowered.com/ISteamUser/GetPlayerSummaries/v0002/
FRONTEND_AUTH_REDIRECT_URL=http://localhost:3000/auth/steam/callback
STEAM_OPENID_STATE_TTL=10m
STEAM_SESSION_JWT_SECRET=
STEAM_SESSION_JWT_ISSUER=dotaops-backend
STEAM_SESSION_JWT_AUDIENCE=dotaops-steam-session
STEAM_SESSION_TTL=7d
STEAM_SESSION_COOKIE_NAME=dotaops_steam_session
STEAM_SESSION_COOKIE_PATH=/
STEAM_SESSION_COOKIE_DOMAIN=
STEAM_SESSION_COOKIE_SECURE=false
STEAM_SESSION_COOKIE_SAME_SITE=Lax
